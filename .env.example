# ─────────────────────────────────────────────────────────────
# RPG AI — variáveis de ambiente. Copie para .env e preencha.
# NUNCA faça commit do arquivo .env.
# ─────────────────────────────────────────────────────────────

# Banco de dados (local: docker compose; produção: Supabase → Project Settings → Database)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rpg_ai

# Redis (local: docker compose)
REDIS_URL=redis://localhost:6379

# Supabase Auth
#  Local: o emulador de testes (pnpm auth:emulator) responde em http://localhost:54321
#  Produção: URL do seu projeto Supabase (https://xxxx.supabase.co)
SUPABASE_URL=http://localhost:54321
# Chave pública "anon" (Supabase → Project Settings → API). Pode ser exposta no navegador.
SUPABASE_ANON_KEY=local-anon-key
# Segredo JWT (projetos com chave legada HS256). Se vazio, a API usa as chaves públicas (JWKS) do SUPABASE_URL.
SUPABASE_JWT_SECRET=local-dev-jwt-secret-change-me-at-least-32-chars

# API
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:3000
# Limite de requisições por minuto por usuário/IP
RATE_LIMIT_PER_MINUTE=120
LOG_LEVEL=info

# Web (variáveis NEXT_PUBLIC_* ficam visíveis no navegador — nunca coloque segredos nelas)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=local-anon-key
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" somente quando o login com Google estiver configurado no Supabase
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
