{
  "name": "rpg-ai",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "test:e2e": "pnpm --filter @rpg-ai/web test:e2e",
    "db:migrate": "pnpm --filter @rpg-ai/db migrate",
    "db:bootstrap-local": "pnpm --filter @rpg-ai/db bootstrap-local",
    "auth:emulator": "node tools/auth-emulator/server.mjs",
    "check:secrets": "node tools/check-secrets.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2"
  }
}
